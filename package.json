	"devDependencies": {
		"@antfu/eslint-config": "^4.19.0",
		"@prettier/plugin-oxc": "^0.0.4",
		"@ruan-cat/commitlint-config": "^4.3.0",
		"@ruan-cat/generate-code-workspace": "^0.6.0",
		"@ruan-cat/taze-config": "^0.3.0",
		"@ruan-cat/utils": "^4.16.0",
		"@types/lodash-es": "^4.17.12",
		"@types/node": "^22.19.1",
		"commitizen": "^4.3.1",
