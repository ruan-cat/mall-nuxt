		"prettier-plugin-lint-md": "^1.0.1",
		"rimraf": "^6.1.2",
		"taze": "^19.9.2",
		"tsx": "^4.21.0",
		"turbo": "^2.6.3",
		"type-plus": "^7.6.2",
		"typescript": "^5.9.3",
